# DO NOT put real values here — this file is committed to git.
# Real secrets are stored in macOS Keychain and loaded via:
#   ./scripts/load-env-from-keychain.sh
#
# To add secrets to Keychain:
#   security add-generic-password -s "kimi-api-key" -a "$USER" -w <your-key> -U
#   security add-generic-password -s "minimax-api-key" -a "$USER" -w <your-key> -U
#   security add-generic-password -s "mathmagics-site-password" -a "$USER" -w <password> -U

KIMI_API_KEY=
MINIMAX_API_KEY=
SITE_PASSWORD=
